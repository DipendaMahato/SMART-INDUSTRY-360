# SMART INDUSTRY 360 - ENVIRONMENT CONFIGURATION
PROJECT_NAME="Smart Industry 360"
VERSION="1.0.0"

# Application Security
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite:///./smart_industry.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/smart_industry"

# MQTT Broker
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_USERNAME="industrial_edge_01"
MQTT_PASSWORD="edge_sec_key_2026"

# Simulation and Engine Controls
SIMULATION_ENABLED=true
ALERT_ESCALATION_TIMEOUT_SECONDS=45
TELEMETRY_INTERVAL_SECONDS=3.0
AI_ANOMALY_THRESHOLD=0.65

# Firebase Realtime Database (Backend Admin SDK)
# Steps:
#   1. Go to Firebase Console → Project smart-industry-90b78
#   2. Project Settings → Service Accounts → Generate new private key
#   3. Save the downloaded JSON as: backend/serviceAccountKey.json
#   4. Set the path below (absolute or relative to where you run uvicorn)
GOOGLE_APPLICATION_CREDENTIALS="backend/serviceAccountKey.json"

